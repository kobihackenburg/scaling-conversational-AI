lab_accuracy  <- "Avg. accuracy (pp)"
} else {
y_label <- "Mean proportion of\naccurate claims"
y_label_short <- "Mean proportion of\naccurate claims"
y_text_pos    <- 0.95
lab_accuracy  <- "Claims >50/100 accuracy (pp)"
}
